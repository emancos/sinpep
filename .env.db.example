# ==============================================================================
# Variáveis de Ambiente para os Bancos de Dados do SINPeP (Docker Compose)
# ==============================================================================

# Credenciais e parâmetros do PostgreSQL (Imagem Mínima Alpine)
POSTGRES_USER=sinpep_user
POSTGRES_PASSWORD=sinpep_password
POSTGRES_DB=sinpep_sb
POSTGRES_PORT=5432

# Lista separada por vírgulas de bancos de dados a serem criados no primeiro boot
POSTGRES_MULTIPLE_DATABASES=sinpep_sb,sipep_sb,sinpep_db,regulasb_db,sigtap

# Parâmetros do Redis (Imagem Mínima Alpine)
REDIS_PORT=6379
