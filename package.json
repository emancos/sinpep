{
  "name": "sinpep",
  "version": "1.4.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=web",
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:web": "turbo build --filter=web",
    "lint": "turbo lint",
    "db:push": "npm --prefix apps/api run db:push",
    "db:seed": "npm --prefix apps/api run db:seed",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,css,prisma}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.11.5",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "ts-jest": {
      "jest": "$jest"
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "bcrypt": true,
    "core-js": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
