{
  "name": "sinpep",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:web": "turbo dev --filter=web",
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:web": "turbo build --filter=web",
    "lint": "turbo lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md,css,prisma}\""
  },
  "devDependencies": {
    "@inquirer/core": "^11.2.1",
    "@rolldown/pluginutils": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.0",
    "get-intrinsic": "^1.3.0",
    "has-symbols": "^1.1.0",
    "is-arrayish": "^0.3.4",
    "jest": "^30.4.2",
    "lodash": "^4.18.1",
    "math-intrinsics": "^1.1.0",
    "object-inspect": "^1.13.4",
    "path-to-regexp": "^8.4.2",
    "prettier": "^3.2.5",
    "resolve-from": "^5.0.0",
    "side-channel": "^1.1.0",
    "ts-jest": "^29.4.11",
    "turbo": "^2.9.16",
    "typescript": "^5.4.5",
    "yargs": "^18.0.0"
  }
}
